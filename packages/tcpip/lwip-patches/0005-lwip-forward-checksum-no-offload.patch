diff --git a/src/core/ipv4/ip4.c b/src/core/ipv4/ip4.c
index e044bff..3aff645 100644
--- a/src/core/ipv4/ip4.c
+++ b/src/core/ipv4/ip4.c
@@ -336,39 +336,18 @@ ip4_forward(struct pbuf *p, struct ip_hdr *iphdr, struct netif *inp)
     IPH_CHKSUM_SET(iphdr, (u16_t)(IPH_CHKSUM(iphdr) + PP_HTONS(0x100)));
   }

-  /* Take care of setting checksums to 0 for checksum offload netifs */
-  if (CHECKSUM_GEN_IP || NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_GEN_IP)) {
-    IPH_CHKSUM_SET(iphdr, 0);
-  }
-  switch (IPH_PROTO(iphdr)) {
-#if LWIP_UDP
-#if LWIP_UDPLITE
-  case IP_PROTO_UDPLITE:
-#endif
-  case IP_PROTO_UDP:
-    if (CHECKSUM_GEN_UDP || NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_GEN_UDP)) {
-      ((struct udp_hdr *)((u8_t *)iphdr + IPH_HL_BYTES(iphdr)))->chksum = 0;
-    }
-    break;
-#endif
-#if LWIP_TCP
-  case IP_PROTO_TCP:
-    if (CHECKSUM_GEN_TCP || NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_GEN_TCP)) {
-      ((struct tcp_hdr *)((u8_t *)iphdr + IPH_HL_BYTES(iphdr)))->chksum = 0;
-    }
-    break;
-#endif
-#if LWIP_ICMP
-  case IP_PROTO_ICMP:
-    if (CHECKSUM_GEN_ICMP || NETIF_CHECKSUM_ENABLED(inp, NETIF_CHECKSUM_GEN_ICMP)) {
-      ((struct icmp_hdr *)((u8_t *)iphdr + IPH_HL_BYTES(iphdr)))->chksum = 0;
-    }
-    break;
-#endif
-  default:
-    /* there's really nothing to do here other than satisfying 'switch-default' */
-    break;
-  }
+  /* pc#714: this wasm build has NO hardware checksum offload — nothing refills a
+     zeroed checksum on TX. Upstream STABLE-2_2_0 unconditionally zeroes the
+     forwarded packet's IP + L4 checksums here (CHECKSUM_GEN_* are compile-time 1
+     and LWIP_CHECKSUM_CTRL_PER_NETIF is off, so the guard collapses to `if (1)`),
+     assuming a checksum-offload NIC will recompute them. No such NIC exists in
+     this build, so every forwarded segment left with checksum 0x0000 and the
+     guest silently dropped it — the guest-internet-egress failure. The
+     incremental IP-checksum update above already keeps the IP header valid
+     across the TTL decrement, and forwarding changes neither the L4 payload nor
+     the TCP/UDP pseudo-header (src/dst IP are unchanged), so the L4 checksum
+     stays valid too. Leave both intact instead of zeroing for an offload NIC
+     that never exists here. */

   LWIP_DEBUGF(IP_DEBUG, ("ip4_forward: forwarding packet to %"U16_F".%"U16_F".%"U16_F".%"U16_F"\n",
                          ip4_addr1_16(ip4_current_dest_addr()), ip4_addr2_16(ip4_current_dest_addr()),
